{
  "name": "janisbiz/light-orm",
  "description": "Light ORM for database integrations",
  "keywords": [
    "janisbiz",
    "orm",
    "database",
    "mysql"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Janis Bizkovskis"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-pdo": "*",
    "janisbiz/heredoc": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "behat/behat": "^4.0",
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.35",
    "monolog/monolog": "^3.12",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpmd/phpmd": "^3.0",
    "phpro/grumphp": "^2.26",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4",
    "rector/rector": "^2.7",
    "squizlabs/php_codesniffer": "^3.0",
    "symfony/var-dumper": "^7.0",
    "symfony/yaml": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Janisbiz\\LightOrm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Janisbiz\\LightOrm\\Tests\\": "tests/",
      "Janisbiz\\LightOrm\\Variable\\": "var/light-orm/"
    },
    "files": [
      "config/config.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true,
      "phpro/grumphp": true
    }
  }
}
